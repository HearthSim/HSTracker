    "There was an issue saving your arena deck. Try relaunching Hearthstone and clicking on 'Arena', and then try to save again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim speichern Deines Arena-Decks ist etwas schief gelaufen. Starte Hearthstone neu, wähle 'Die Arena' aus und versuche es dann erneut zu speichern."
          }
        },
        "en" : {
          "stringUnit" : {
