    "MulliganGV2_Warning_LowData" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnung: wenig Daten\n\nDie angezeigten Behalten-Raten sind möglicherweise weniger zuverlässig"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Low Data Warning\n\nDisplayed keep-rates may be less reliable"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aviso de falta de datos\n\nLas tasas de conservación pueden ser poco fiables"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advertencia por pocos datos\n\nLas tasas de conservación mostradas pueden ser menos confiables"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avertissement : peu de données\n\nLes taux de conservation affichés peuvent être moins fiables"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avviso: dati insufficienti\n\nLe percentuali di tenuta mostrate potrebbero essere meno affidabili"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データ不足警告\n\n表示されているキープ率は信頼性が低い可能性があります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터 부족 경고\n\n표시된 유지 비율의 신뢰도가 낮을 수 있습니다"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostrzeżenie o deficycie danych\n\nWyświetlane prawdopodobieństwo zachowania może być nieprecyzyjne"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aviso de poucos dados\n\nTaxas de manutenção mostradas podem ser menos confiáveis"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предупреждение о недостатке данных\n\nОтображаемые проценты удержания могут быть менее надежными"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据少警告\n\n 显示的保存率可能更不可靠。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料不足警告\n\n顯示的保留率可能較不可靠"
          }
        }
      }
    },
    "MulliganGV2_Warning_LowDataCombination" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnung: wenig Daten\n\nWir verfügen über genug Daten zu dieser Karte, jedoch nicht in Kombination mit einigen der anderen vorgeschlagenen Karten.\nDie angezeigten Behalten-Raten sind möglicherweise weniger zuverlässig"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Low Data Warning\n\nWe have enough data for this card, but not in combination with some of the other offered cards.\nDisplayed keep-rates may be less reliable"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aviso de falta de datos\n\nTenemos datos suficientes sobre la carta, pero no con la combinación de algunas cartas ofrecidas.\nLas tasas de conservación pueden ser poco fiables"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advertencia por pocos datos\n\nTenemos suficientes datos para esta carta, pero no en combinación con algunas de las otras cartas ofrecidas.\nLas tasas de conservación mostradas pueden ser menos confiables"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avertissement : peu de données\n\nNous avons suffisamment de données pour cette carte, mais pas en combinaison avec certaines des autres cartes proposées.\nLes taux de conservation affichés peuvent être moins fiables"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avviso: dati insufficienti\n\nAbbiamo dati sufficienti per questa carta, ma non in combinazione con alcune delle altre carte offerte.\nLe percentuali di tenuta mostrate potrebbero essere meno affidabili"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データ不足警告\n\nこのカード単体のデータは十分ですが、他の提示カードとの組み合わせデータが不足しています。\n表示されているキープ率は信頼性が低い可能性があります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터 부족 경고\n\n이 카드에 대한 데이터는 충분하지만 제공된 다른 일부 카드와의 조합 데이터는 충분하지 않습니다.\n표시된 유지 비율의 신뢰도가 낮을 수 있습니다"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostrzeżenie o deficycie danych\n\nDysponujemy wystarczającymi danymi dot. tej karty – ale nie w połączeniu z pozostałymi dostępnymi kartami.\nWyświetlane prawdopodobieństwa mogą być nieprecyzyjne"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aviso de poucos dados\n\n\n\nTemos dados suficientes para esta carta, mas não quando combinada com algumas das outras cartas oferecidas.\nTaxas de manutenção mostradas podem ser menos confiáveis"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предупреждение о недостатке данных\n\nУ нас достаточно данных по этой карте, но не в сочетании с некоторыми из других предложенных карт.\nОтображаемые проценты удержания могут быть менее надежными"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据少警告\n\n 我们虽有关于此卡足够的数据，但不是与其它的卡牌组合。\n显示的保存率可能较不可靠。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料不足警告\n\n此卡牌的相關資料雖然足夠，但尚缺少其與部分發放卡牌組合的相關資料。\n顯示的保留率可能較不可靠"
          }
        }
      }
    },
