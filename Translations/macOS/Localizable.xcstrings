    "MulliganGV2_ContextualKeepRate_Description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top-Spieler behalten %@ in %d %% der Fälle mit dieser Hand, Initiative, Gegnerklasse und diesem Deck."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top players keep %@ %d%% of the time with this hand, deck, initiative, and opponent class."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los mejores jugadores la conservan el %@ %d %% de las veces con esta mano, mazo, iniciativa y clase del oponente."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los jugadores de alto nivel conservan %@ el %d%% de las veces con esta mano, deck, iniciativa y clase del oponente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les joueurs du top gardent %@ %d %% du temps avec cette main, ce deck, cette initiative et un adversaire de cette classe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I top player tengono %@ nel %d%% dei casi con questa mano, questo mazzo, questa iniziativa e questa classe avversaria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この手札・デッキ・先攻/後攻・相手クラスの条件において、トッププレイヤーは「%@」を%d%%の確率でキープします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상위 플레이어는 이 손패, 덱, 선후공, 상대 직업에서 %d%%의 비율로 %@을(를) 유지합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czołowi gracze zachowaliby kartę %@ w %d%% przypadków z tą ręką, talią, inicjatywą i klasą przeciwnika."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os melhores jogadores mantêm %@, %d%% das vezes com esta mão, deck, iniciativa e classe do adversário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Топ-игроки оставляют %@ в %d%% случаев при данной руке, колоде, инициативе и классе оппонента."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顶级玩家在这个手牌、卡组、先后手和对手职业之下，保留了 %@ %d%%的次数"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頂尖玩家在目前手牌、套牌、先後手及對手職業下，保留 %@ 的機率為 %d%%。"
          }
        }
      }
    },
