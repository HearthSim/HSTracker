    "MulliganGV2_DynamicKeepRate_Negative_Description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top-Spieler würden %@ in %d %% der Fälle seltener behalten, wenn die zum Austausch markierten Karten (X) nicht angeboten würden.\n\nKontextbezogene Behalten-Rate: %d %%"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top players would keep %@ %d%% less often if the cards marked to be replaced (X) were not offered.\n\nContextual Keep Rate: %d%%"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La frecuencia de conservación de los mejores jugadores sería de un %@ %d %% menos si las cartas marcadas para remplazar (X) no se ofrecieran.\n\nTasa de conservación en contexto: %d %%"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los jugadores de alto nivel conservarían %@ un %d%% menos a menudo si las cartas marcadas para reemplazar (X) no se ofrecieran.\n\nTasa contextual de conservación: %d%%"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les joueurs du top conserveraient %@ %d %% moins souvent si les cartes marquées à remplacer (X) n'étaient pas proposées.\n\nTaux de conservation contextuel : %d %%"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I top player terrebbero %@ nel %d%% dei casi in meno se le carte segnate per la sostituzione (X) non venissero offerte.\n\nPercentuale di tenuta contestuale: %d%%"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "交換対象（X）のカードが提示されていない場合、トッププレイヤーは「%@」を%d%%低い確率でキープします。\n\n状況別キープ率：%d%%"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상위 플레이어는 교체(X) 표시된 카드가 없는 경우 %d%% 적게 %@을(를) 유지합니다.\n\n컨텍스트에 따른 유지 비율: %d%%"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czołowi gracze zachowaliby kartę %@ w %d%% mniej przypadków, gdyby karty zaznaczone do wymiany (X) nie były dostępne.\n\nKontekstowe prawd. zachowania: %d%%"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os melhores jogadores manteriam %@, com %d%% menos frequência se as cartas marcadas para substituição (X) não fossem oferecidas.\n\nTaxa de manutenção contextual: %d%%"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Топ-игроки оставляли бы %@ на %d%% реже, если бы карты, отмеченные для замены (X), не предлагались.\n\nКонтекстуальный процент удержания: %d%%"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当标记的卡牌(X)被换掉时，顶级玩家会 %d%%更少的保留%@。\n\n全手牌整体保留率: %d%%"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
