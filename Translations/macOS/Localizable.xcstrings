    "Automatically pin cards which are key pieces for comps available in the current lobby. These are based on “Enablers” and “When to commit” from our comp guides." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically pin cards which are key pieces for comps available in the current lobby. These are based on “Enablers” and “When to commit” from our comp guides."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixar automaticamente os cards que são peças-chaves das comps disponíveis no lobby atual. Baseado em “Ativadores” e “Quando dedicar-se” dos nossos guias de comp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动标记当前对局可用流派的关键随从。这些卡牌基于我们流派指南中的“启动核心”和“成型核心”部分。"
          }
        }
      }
    },
    "AverageDamage_Info_Description" : {
      "extractionState" : "manual",
      "localizations" : {
